# No secrets in this template. Hosted mode stays closed until all values are set.
POKER_MODE=hosted
POKER_RESOURCE=https://YOUR-SERVICE.onrender.com/mcp
POKER_OAUTH_ISSUER=https://YOUR-TENANT.REGION.auth0.com/
POKER_OAUTH_JWKS_URL=https://YOUR-TENANT.REGION.auth0.com/.well-known/jwks.json
# Exact Auth0 user_id for the intended owner; set privately in Render.
POKER_ALLOWED_SUBJECTS=
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
